# ============================================================================
# CropBalance-AI Environment Configuration
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cropbalance:cropbalance_pass@postgres:5432/cropbalance_db
POSTGRES_USER=cropbalance
POSTGRES_PASSWORD=cropbalance_pass
POSTGRES_DB=cropbalance_db

# ────────────────────────────────────────────────────────────────────────────
# Redis Cache Configuration
# ────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ────────────────────────────────────────────────────────────────────────────
# External APIs (Optional - System uses synthetic data without keys)
# ────────────────────────────────────────────────────────────────────────────

# OpenWeatherMap API Key
# Get free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Agmarknet API Key (Government Mandi Prices)
# Get from: https://agmarknet.gov.in
AGMARKNET_API_KEY=

# eNAM API Key (National Agriculture Market)
# Get from: https://enam.gov.in
ENAM_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Application Configuration
# ────────────────────────────────────────────────────────────────────────────

# FastAPI Server
DEBUG=false
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Deployment Environment
ENVIRONMENT=production

# ────────────────────────────────────────────────────────────────────────────
# Model Configuration (Optional - uses defaults from config.py)
# ────────────────────────────────────────────────────────────────────────────
# MODEL_SEQUENCE_LENGTH=60
# MODEL_HIDDEN_SIZE=128
# MODEL_EPOCHS=100
# MODEL_BATCH_SIZE=32

# ────────────────────────────────────────────────────────────────────────────
# Domain/Host Configuration (For production deployment)
# ────────────────────────────────────────────────────────────────────────────
# API_DOMAIN=localhost
# API_PORT=8000
